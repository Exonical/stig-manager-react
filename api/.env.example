# Listen address for the HTTP API.
STIGMAN_HTTP_ADDR=:54001

# Postgres connection. The API runs goose migrations on start, so this
# user needs CREATE / DROP privileges on the target database. When
# unset, the API still boots but every database-backed endpoint
# degrades (lists return [], create returns 503).
STIGMAN_DATABASE_URL=postgres://stigman:stigman@localhost:5432/stigman?sslmode=disable

# Comma-separated CORS origins.
STIGMAN_ALLOWED_ORIGINS=http://localhost:54000,http://127.0.0.1:54000

# Log level: debug | info | warn | error
STIGMAN_LOG_LEVEL=info

# ---- OIDC ----
# Issuer URL used by the API to validate access tokens (must include the
# realm path for Keycloak). When unset, the API runs in unauthenticated
# mode and every protected endpoint will 401.
STIGMAN_OIDC_PROVIDER=http://localhost:8080/realms/stigman
# Expected `aud` claim on incoming tokens. Set to the OIDC client id for
# Keycloak (the realm import adds an audience mapper so access tokens
# include this).
STIGMAN_OIDC_AUDIENCE=stig-manager

# JWT claim paths the API extracts. Defaults match Keycloak access
# tokens; override per-deployment for Okta / Entra / Auth0 etc.
STIGMAN_JWT_USERNAME_CLAIM=preferred_username
STIGMAN_JWT_NAME_CLAIM=name
STIGMAN_JWT_EMAIL_CLAIM=email
STIGMAN_JWT_PRIVILEGES_CLAIM=realm_access.roles
STIGMAN_JWT_SCOPE_CLAIM=scope
STIGMAN_JWT_ASSERTION_CLAIM=jti

# ---- SPA-facing settings served via /js/Env.js ----
# Authority URL advertised to the SPA. Defaults to STIGMAN_OIDC_PROVIDER;
# override when the SPA reaches the OIDC provider on a different
# hostname (e.g. browser hits http://localhost:8080 while the API hits
# http://keycloak:8080 inside the compose network).
STIGMAN_CLIENT_OIDC_PROVIDER=http://localhost:8080/realms/stigman
STIGMAN_CLIENT_ID=stig-manager
STIGMAN_CLIENT_API_BASE=api
# Extra scopes (space-separated) appended to the default set.
STIGMAN_CLIENT_EXTRA_SCOPES=
# Scope prefix for IdPs that namespace scopes (e.g. Entra ID).
STIGMAN_CLIENT_SCOPE_PREFIX=
# Audience parameter sent on the authorize request (Auth0 / Okta style).
STIGMAN_CLIENT_AUDIENCE_VALUE=
# fragment | query
STIGMAN_CLIENT_RESPONSE_MODE=fragment
STIGMAN_CLIENT_STRICT_PKCE=true
